# AI Trading Assistant Environment Variables

# OpenAI API Key for AI analysis and chat functionality
OPENAI_API_KEY=your_openai_api_key_here

# Alpha Vantage API Key for market data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Polygon.io API Key for real-time market data
POLYGON_API_KEY=your_polygon_api_key_here

# Twelve Data API Key (optional)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Financial Modeling Prep API Key (optional)
FMP_API_KEY=your_fmp_api_key_here

# Database Configuration (optional - defaults to SQLite)
DATABASE_URL=sqlite:///./trading_assistant.db

# Redis Configuration (optional - for caching)
REDIS_URL=redis://localhost:6379

# Application Configuration
APP_NAME=AI Trading Assistant
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=your_secret_key_here

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Rate Limiting (requests per minute)
RATE_LIMIT=100

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=trading_assistant.log

# Email Configuration (optional - for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Webhook Configuration (optional - for trading signals)
WEBHOOK_URL=https://your-webhook-url.com/trading-signals

# Feature Flags
ENABLE_CHART_ANALYSIS=True
ENABLE_TRADING_SIGNALS=True
ENABLE_MARKET_DATA=True
ENABLE_AI_CHAT=True